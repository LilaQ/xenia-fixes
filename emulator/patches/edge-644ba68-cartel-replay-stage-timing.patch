 namespace xe {
 namespace gpu {
 namespace d3d12 {
+
+namespace {
+struct TraceCpuFrame {
+  uint64_t ticks[8] = {};
+  uint32_t calls[8] = {};
+};
+std::mutex trace_cpu_mutex;
+std::unordered_map<uint64_t, TraceCpuFrame> trace_cpu_frames;
+class TraceCpuScope {
+ public:
+  TraceCpuScope(uint64_t frame, uint32_t stage) : frame_(frame), stage_(stage) {
+    start_ = cvars::trace_cpu_timing ? Clock::QueryHostTickCount() : 0;
+  }
+  ~TraceCpuScope() {
+    if (start_) {
+      const uint64_t elapsed = Clock::QueryHostTickCount() - start_;
+      std::lock_guard<std::mutex> lock(trace_cpu_mutex);
+      auto& frame = trace_cpu_frames[frame_];
+      frame.ticks[stage_] += elapsed;
+      ++frame.calls[stage_];
+    }
+  }
+ private:
+  uint64_t frame_, start_;
+  uint32_t stage_;
+};
+}
 
