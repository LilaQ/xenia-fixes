+void SharedMemory::RecordCpuMemoryReadInTrace(TraceWriter& trace_writer,
+                                              uint32_t start, uint32_t length) {
+  if (!trace_writer.is_open() || !length || start >= kBufferSize) {
+    return;
+  }
+  const uint32_t end = start + std::min(length, kBufferSize - start);
+  auto global_lock = global_critical_region_.Acquire();
+  uint32_t cpu_run_start = UINT32_MAX;
+  for (uint32_t address = start; address < end;) {
+    const uint32_t page = address >> page_size_log2_;
+    const bool gpu_written =
+        (system_page_flags_valid_and_gpu_written_[page >> 6] &
+         (UINT64_C(1) << (page & 63))) != 0;
+    if (gpu_written) {
+      if (cpu_run_start != UINT32_MAX) {
+        trace_writer.WriteMemoryReadCached(cpu_run_start,
+                                            address - cpu_run_start);
+        cpu_run_start = UINT32_MAX;
+      }
+    } else if (cpu_run_start == UINT32_MAX) {
+      cpu_run_start = address;
+    }
+    address = std::min(end, (page + 1) << page_size_log2_);
+  }
+  if (cpu_run_start != UINT32_MAX) {
+    trace_writer.WriteMemoryReadCached(cpu_run_start, end - cpu_run_start);
+  }
+}
