 void DeferredCommandList::Reset() { command_stream_.clear(); }
 
+bool DeferredCommandList::DiscardTrailingTimestampQuery(size_t previous_size_bytes) {
+  constexpr size_t header_size = kCommandHeaderSizeElements * sizeof(uintmax_t);
+  const size_t args_size =
+      round_up(sizeof(D3DQueryArguments), sizeof(uintmax_t), false);
+  if (previous_size_bytes > command_stream_.size() ||
+      command_stream_.size() - previous_size_bytes != header_size + args_size) {
+    return false;
+  }
+  const auto* header = reinterpret_cast<const CommandHeader*>(
+      command_stream_.data() + previous_size_bytes);
+  if (header->command != Command::kD3DEndQuery ||
+      header->arguments_size_elements != args_size / sizeof(uintmax_t)) {
+    return false;
+  }
+  const auto* args = reinterpret_cast<const D3DQueryArguments*>(
+      command_stream_.data() + previous_size_bytes + header_size);
+  if (args->query_type != D3D12_QUERY_TYPE_TIMESTAMP) {
+    return false;
+  }
+  command_stream_.resize(previous_size_bytes);
+  return true;
+}
