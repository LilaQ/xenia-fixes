+bool D3D12RenderTargetCache::EnsureStencilCopyTexture(
+    D3D12RenderTarget& target) {
+  if (target.stencil_copy_texture_) {
+    return true;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  D3D12_RESOURCE_DESC desc = target.resource()->GetDesc();
+  if (desc.SampleDesc.Count == 1) {
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint = {};
+    UINT64 row_bytes = 0;
+    device->GetCopyableFootprints(&desc, 1, 1, 0, &footprint, nullptr,
+                                  &row_bytes, nullptr);
+    if (footprint.Footprint.Format != DXGI_FORMAT_R8_TYPELESS ||
+        row_bytes != desc.Width) {
+      XELOGE("Stencil plane copy: unsupported destination footprint");
+      return false;
+    }
+  }
+  desc.Format = DXGI_FORMAT_R8_UINT;
+  desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+  auto descriptor = descriptor_pool_color_->AllocateDescriptor();
+  if (!descriptor.IsValid()) {
+    return false;
+  }
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE, &desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&target.stencil_copy_texture_)))) {
+    return false;
+  }
+  D3D12_RENDER_TARGET_VIEW_DESC view = {};
+  view.Format = DXGI_FORMAT_R8_UINT;
+  view.ViewDimension = desc.SampleDesc.Count > 1
+                           ? D3D12_RTV_DIMENSION_TEXTURE2DMS
+                           : D3D12_RTV_DIMENSION_TEXTURE2D;
+  device->CreateRenderTargetView(target.stencil_copy_texture_.Get(), &view,
+                                 descriptor.GetHandle());
+  target.stencil_copy_rtv_ = std::move(descriptor);
+  return true;
+}
