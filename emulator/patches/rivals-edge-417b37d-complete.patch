+void D3D12CommandProcessor::StageSmallResolveSnapshot(uint32_t address,
+                                                    uint32_t length) {
+  if (!cvars::d3d12_stage_small_readback || shared_memory_->is_zero_copy() ||
+      !length || length > 65536 || (length & 4095) || (address & 4095) ||
+      !ResolveReadRecently(MakeReadbackResolveKey(address, length), false)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(resolve_read_mutex_);
+  auto owner = resolve_owners_.find(MakeReadbackResolveKey(address, length));
+  if (owner == resolve_owners_.end()) {
+    return;
+  }
+  uint64_t completed = completion_timeline_->GetFence()->GetCompletedValue();
+  if (completed == UINT64_MAX) {
+    return;
+  }
+  for (uint32_t attempt = 0; attempt < small_resolve_snapshots_.size();
+       ++attempt) {
+    auto& snapshot = small_resolve_snapshots_[next_small_resolve_snapshot_];
+    next_small_resolve_snapshot_ =
+        (next_small_resolve_snapshot_ + 1) % small_resolve_snapshots_.size();
+    if (snapshot.submission > completed) {
+      continue;
+    }
+    if (!snapshot.buffer.resource &&
+        !CreateReadbackStagingBuffer(snapshot.buffer, 65536)) {
+      return;
+    }
+    shared_memory_->UseAsCopySource();
+    SubmitBarriers();
+    deferred_command_list_.D3DCopyBufferRegion(
+        snapshot.buffer.resource.Get(), 0, shared_memory_->GetBuffer(), address,
+        length);
+    snapshot.address = address;
+    snapshot.length = length;
+    snapshot.generation = owner->second.generation;
+    snapshot.submission = GetCurrentSubmission();
+    snapshot.frame = resolve_frame_index_;
+    return;
+  }
+}
