+bool D3D12CommandProcessor::TryConsumeGatHdrSnapshot(uint32_t address) {
+  if (!cvars::d3d12_gat_async_hdr && !cvars::d3d12_sr4_async_hdr &&
+      !cvars::d3d12_sr3_async_hdr) {
+    return false;
+  }
+  auto* thread = cpu::ThreadState::Get();
+  auto* kernel = kernel::KernelState::shared();
+  auto* guest = thread ? thread->context() : nullptr;
+  if (!guest || !kernel) {
+    return false;
+  }
+  const uint32_t title = kernel->title_id();
+  const auto* layout = GetSaintsHdrReaderLayout(title);
+  if (!layout || uint32_t(guest->lr) != layout->caller + 4 ||
+      (title == 0x4B4D0800 && !cvars::d3d12_gat_async_hdr) ||
+      (title == 0x4B4D07F6 && !cvars::d3d12_sr4_async_hdr) ||
+      (title == 0x5451086D && !cvars::d3d12_sr3_async_hdr)) {
+    return false;
+  }
+  if (layout->module_hash) {
+    auto module = kernel->GetExecutableModule();
+    if (!module || module->hash() != layout->module_hash) {
+      return false;
+    }
+  }
+  if (gat_hdr_reader_thread_ &&
+      gat_hdr_reader_thread_ != thread->thread_id()) {
+    return false;
+  }
+  // Exact original reader and its call site, not a title-wide readback bypass.
+  const auto* code = memory_->TranslateVirtual<const uint8_t*>(layout->reader);
+  for (size_t i = 0; i < layout->reader_prefix.size(); ++i) {
+    if (xe::load_and_swap<uint32_t>(code + i * 4) != layout->reader_prefix[i]) {
+      return false;
+    }
+  }
+  if (xe::load_and_swap<uint32_t>(
+          memory_->TranslateVirtual<const uint8_t*>(layout->caller)) !=
+          layout->caller_instruction) {
+    return false;
+  }
+  // These native texture descriptors are CPU-owned physical allocations. Use
+  // the unprotected physical view while holding the resolve metadata lock.
+  auto read_word = [this](uint32_t pointer, uint32_t& value) {
+    if (pointer < 0xA0000000 || pointer > 0xBFFFFFFC || (pointer & 3)) {
+      return false;
+    }
+    value = xe::load_and_swap<uint32_t>(
+        memory_->TranslatePhysical<const uint8_t*>(pointer & 0x1FFFFFFF));
+    return true;
+  };
+  uint32_t object = uint32_t(guest->r[3]);
+  uint32_t slot, manager;
+  uint32_t root = xe::load_and_swap<uint32_t>(
+      memory_->TranslateVirtual<const uint8_t*>(layout->texture_manager_root));
+  if (!read_word(object + layout->slot_offset, slot) || slot > 1 ||
+      !read_word(root + 0xC0, manager)) {
+    return false;
+  }
+  std::array<uint32_t, 2> addresses;
+  for (uint32_t part = 0; part < 2; ++part) {
+    uint32_t id, pointer;
+    if (!read_word(object + layout->texture_id_offsets[part] + slot * 4, id) ||
+        id >= 96 || manager < 0xA0000000 || manager > 0xBFFF0000 ||
+        *memory_->TranslatePhysical<const uint8_t*>(
+            (manager + id + layout->pool_flag_offset) & 0x1FFFFFFF) ||
+        !read_word(manager + id * layout->descriptor_stride +
+                       layout->page_pointer_offset, pointer) ||
+        pointer < 0xA0000000 || pointer > 0xBFFFF000 || (pointer & 4095)) {
+      return false;
+    }
+    addresses[part] = pointer & 0x1FFFFFFF;
+  }
+  if (addresses[0] == addresses[1] ||
+      (address != addresses[0] && address != addresses[1])) {
+    return false;
+  }
+  auto first = resolve_owners_.find(MakeReadbackResolveKey(addresses[0], 4096));
+  auto second = resolve_owners_.find(MakeReadbackResolveKey(addresses[1], 4096));
+  if (first == resolve_owners_.end() || second == resolve_owners_.end() ||
+      first->second.address != addresses[0] ||
+      second->second.address != addresses[1] ||
+      first->second.length != 4096 || second->second.length != 4096 ||
+      !first->second.copyable || !second->second.copyable ||
+      resolve_page_owners_[addresses[0] >> 12].load(
+          std::memory_order_relaxed) !=
+          MakeReadbackResolveKey(addresses[0], 4096) ||
+      resolve_page_owners_[addresses[1] >> 12].load(
+          std::memory_order_relaxed) !=
+          MakeReadbackResolveKey(addresses[1], 4096) ||
+      first->second.frame != second->second.frame) {
+    return false;
+  }
+  const uint64_t owner_frame = first->second.frame;
+  uint64_t snapshot_frame;
+  if (address == addresses[0]) {
+    gat_hdr_peer_address_ = 0;
+    if (second->second.in_guest_ram) {
+      return false;
+    }
+    std::array<HdrFeedbackSnapshotKey, 32> keys{};
+    for (size_t i = 0; i < keys.size(); ++i) {
+      const auto& snapshot = small_resolve_snapshots_[i];
+      bool available = snapshot.buffer.mapped != nullptr;
+      if (snapshot.frame == owner_frame) {
+        if (snapshot.address == addresses[0]) {
+          available &= snapshot.submission == first->second.submission;
+        } else if (snapshot.address == addresses[1]) {
+          available &= snapshot.submission == second->second.submission;
+        }
+      }
+      keys[i] = {snapshot.address, snapshot.frame, snapshot.submission,
+                 available};
+    }
+    auto selected = SelectHdrFeedbackPair(
+        keys.data(), keys.size(), addresses, owner_frame,
+        completion_timeline_->GetFence()->GetCompletedValue());
+    if (selected[0] == keys.size()) {
+      return false;
+    }
+    const auto& a = small_resolve_snapshots_[selected[0]];
+    const auto& b = small_resolve_snapshots_[selected[1]];
+    gat_hdr_reader_thread_ = thread->thread_id();
+    // Pin the paired peer bytes across the two actual CPU reads, even if the
+    // producer fence advances or a staging slot is reused between them.
+    std::memcpy(gat_hdr_peer_page_.data(), b.buffer.mapped, 4096);
+    gat_hdr_peer_address_ = addresses[1];
+    gat_hdr_peer_object_ = object;
+    gat_hdr_peer_thread_ = thread->thread_id();
+    gat_hdr_peer_owner_submission_ = second->second.submission;
+    gat_hdr_peer_owner_frame_ = owner_frame;
+    gat_hdr_peer_snapshot_frame_ = a.frame;
+    snapshot_frame = a.frame;
+    CopyPackedRangesToGuestRam(a.buffer.mapped, {{address, 4096}});
+  } else {
+    if (gat_hdr_peer_address_ != address || gat_hdr_peer_object_ != object ||
+        gat_hdr_peer_thread_ != thread->thread_id() ||
+        gat_hdr_peer_owner_submission_ != second->second.submission ||
+        gat_hdr_peer_owner_frame_ != owner_frame) {
+      return false;
+    }
+    snapshot_frame = gat_hdr_peer_snapshot_frame_;
+    CopyPackedRangesToGuestRam(gat_hdr_peer_page_.data(), {{address, 4096}});
+    gat_hdr_peer_address_ = 0;
+  }
+  if (cvars::d3d12_submission_timing) {
+    gat_hdr_delayed_reads_ += snapshot_frame < owner_frame;
+    if (++gat_hdr_async_reads_ == 64) {
+      XELOGI("Saints HDR feedback {:08X}: 64 paired page reads without a producer wait; "
+             "{} delayed, newest sample age {} frames",
+             title, gat_hdr_delayed_reads_, owner_frame - snapshot_frame);
+      gat_hdr_async_reads_ = 0;
+      gat_hdr_delayed_reads_ = 0;
+    }
+  }
+  return true;
+}
+
+bool D3D12CommandProcessor::TryConsumeSmallResolveSnapshot(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  // Called only from ProvideResolveOutput under resolve_read_mutex_. Require
+  // the entire, still-current owner; partial pages and mixed owners retain the
+  // ordinary coherent fallback.
+  if (!cvars::d3d12_stage_small_readback || ranges.size() != 1 ||
+      !ranges.front().second || ranges.front().second > 65536 ||
+      (ranges.front().second & 4095) || (ranges.front().first & 4095)) {
+    return false;
+  }
+  uint32_t address = ranges.front().first;
+  uint32_t length = ranges.front().second;
+  auto owner = resolve_owners_.find(MakeReadbackResolveKey(address, length));
+  if (owner == resolve_owners_.end() || owner->second.address != address ||
+      owner->second.length != length || !owner->second.copyable ||
+      resolve_page_owners_[address >> 12].load(std::memory_order_relaxed) !=
+          MakeReadbackResolveKey(address, length)) {
+    return false;
+  }
+  const uint64_t owner_key = MakeReadbackResolveKey(address, length);
+  for (uint32_t page = address >> 12, end = page + (length >> 12);
+       page < end; ++page) {
+    if (resolve_page_owners_[page].load(std::memory_order_relaxed) != owner_key) {
+      return false;
+    }
+  }
+  if (length == 4096 && TryConsumeGatHdrSnapshot(address)) {
+    return true;
+  }
+  for (const auto& snapshot : small_resolve_snapshots_) {
+    if (snapshot.address != address || snapshot.length != length ||
+        snapshot.submission != owner->second.submission ||
+        snapshot.generation != owner->second.generation ||
+        !snapshot.buffer.mapped) {
+      continue;
+    }
+    const uint64_t start = xe::Clock::QueryHostTickCount();
+    // Wait for the snapshot's own already-submitted fence, not for a new
+    // signal placed after unrelated later rendering. Do not mutate the
+    // GPU-thread-only completion timeline from this faulting thread.
+    ID3D12Fence* fence = completion_timeline_->GetFence();
+    if (FAILED(fence->SetEventOnCompletion(snapshot.submission, nullptr)) ||
+        fence->GetCompletedValue() == UINT64_MAX) {
+      return false;
+    }
+    CopyPackedRangesToGuestRam(snapshot.buffer.mapped, ranges);
+    if (cvars::d3d12_submission_timing) {
+      small_resolve_snapshot_wait_ticks_ +=
+          xe::Clock::QueryHostTickCount() - start;
+      small_resolve_snapshot_bytes_ += length;
+      if (++small_resolve_snapshot_hits_ == 64) {
+        XELOGI("Resolve staged timing: 64 exact-owner bounded reads, wait/copy "
+               "avg {:.3f} ms; avg bytes {}",
+               double(small_resolve_snapshot_wait_ticks_) * 1000.0 /
+                   double(xe::Clock::QueryHostTickFrequency()) / 64.0,
+               small_resolve_snapshot_bytes_ / 64);
+        small_resolve_snapshot_bytes_ = 0;
+        small_resolve_snapshot_hits_ = 0;
+        small_resolve_snapshot_wait_ticks_ = 0;
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
 bool D3D12CommandProcessor::FaultCopyResolveToGuestRam(
     const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
   if (ranges.empty()) {
     return false;
   }
+  if (TryConsumeSmallResolveSnapshot(ranges)) {
+    return true;
+  }
+  uint64_t measured_bytes = 0;
+  uint64_t later_submissions = 0;
+  uint32_t owner_address = 0;
+  uint32_t owner_length = 0;
+  if (cvars::d3d12_submission_timing) {
+    for (const auto& range : ranges) {
+      measured_bytes += range.second;
+    }
+    uint64_t key = resolve_page_owners_[ranges.front().first >> 12].load(
+        std::memory_order_relaxed);
