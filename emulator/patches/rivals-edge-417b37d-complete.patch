+TextureCache::Texture::GetDirtyBaseBands(uint32_t band_bytes) {
+  auto lock = texture_cache_.global_critical_region_.Acquire();
+  if (!base_range_tracking_ || dirty_base_first_ == UINT32_MAX || !band_bytes)
+    return {{0, GetGuestBaseSize()}};
+  std::vector<std::pair<uint32_t, uint32_t>> ranges;
+  for (uint32_t i = 0; i < base_range_watch_handles_.size(); ++i) {
+    if (base_range_watch_handles_[i]) continue;
+    uint32_t first = i * 65536u / band_bytes * band_bytes;
+    uint32_t end = std::min(GetGuestBaseSize(),
+        ((i + 1) * 65536u + band_bytes - 1) / band_bytes * band_bytes);
+    if (!ranges.empty() && first <= ranges.back().second) {
+      ranges.back().second = std::max(ranges.back().second, end);
+    } else {
+      ranges.emplace_back(first, end);
+    }
+  }
+  if (ranges.empty()) return {{0, GetGuestBaseSize()}};
+  return ranges;
+}
+
+void TextureCache::Texture::BaseRangeWatchCallback(
+    const global_unique_lock_type& lock, uint32_t chunk) {
+  assert_true(lock.owns_lock());
+  assert_true(chunk < base_range_watch_handles_.size());
+  dirty_base_first_ = std::min(dirty_base_first_, chunk * 65536u);
+  dirty_base_end_ = std::max(dirty_base_end_,
+      std::min((chunk + 1) * 65536u, GetGuestBaseSize()));
+  base_outdated_ = true;
+  base_range_watch_handles_[chunk] = nullptr;
+}
+
+void TextureCache::BaseRangeWatchCallback(
+    const global_unique_lock_type& lock, void* context, void*,
+    uint64_t argument, bool) {
+  auto& texture = *static_cast<Texture*>(context);
+  texture.BaseRangeWatchCallback(lock, uint32_t(argument));
+  texture.texture_cache().texture_became_outdated_.store(true,
+                                                        std::memory_order_release);
+}
+
+bool TextureCache::Texture::EnableMipLevelTracking() {
+  auto lock = texture_cache_.global_critical_region_.Acquire();
+  if (mip_level_tracking_ || mips_watch_handle_ || key().packed_mips ||
+      !key().mip_max_level || key().mip_max_level >= xenos::kTextureMaxMips ||
+      !GetGuestMipsSize()) {
+    return false;
+  }
+  if (key().dimension != xenos::DataDimension::kCube ||
+      key().GetDepthOrArraySize() != 6) {
+    return false;
+  }
+  for (uint32_t level = 1; level <= key().mip_max_level; ++level) {
+    const auto& layout = guest_layout().mips[level];
+    if (!layout.array_slice_stride_bytes ||
+        layout.level_data_extent_bytes <= 5 * layout.array_slice_stride_bytes) {
+      return false;
+    }
   }
+  mip_level_tracking_ = true;
+  mip_slices_outdated_.fill(0x3F);
+  mip_levels_outdated_ = (uint32_t(1) << (key().mip_max_level + 1)) - 2;
+  mips_outdated_ = true;
   return true;
 }
 
+uint32_t TextureCache::Texture::GetOutdatedMipLevels() {
+  auto lock = texture_cache_.global_critical_region_.Acquire();
+  return mip_level_tracking_ ? mip_levels_outdated_ : UINT32_MAX;
+}
+
+uint32_t TextureCache::Texture::GetOutdatedMipSlices(uint32_t level) {
+  auto lock = texture_cache_.global_critical_region_.Acquire();
+  return mip_level_tracking_ ? mip_slices_outdated_[level] : UINT32_MAX;
+}
+
+void TextureCache::Texture::MipLevelWatchCallback(
+    const global_unique_lock_type& global_lock, uint32_t level, uint32_t slice) {
+  assert_true(global_lock.owns_lock());
+  assert_true(slice < 6);
+  assert_true(level && level <= key().mip_max_level);
+  mip_levels_outdated_ |= uint32_t(1) << level;
+  mip_slices_outdated_[level] |= uint8_t(1) << slice;
+  mips_outdated_ = true;
+  mip_level_watch_handles_[level * 6 + slice] = nullptr;
+}
+
+void TextureCache::MipLevelWatchCallback(
+    const global_unique_lock_type& global_lock, void* context, void* data,
+    uint64_t argument, bool invalidated_by_gpu) {
+  auto& texture = *static_cast<Texture*>(context);
+  texture.MipLevelWatchCallback(global_lock, uint32_t(argument) / 6,
+                                uint32_t(argument) % 6);
+  texture.texture_cache().texture_became_outdated_.store(
+      true, std::memory_order_release);
+}
