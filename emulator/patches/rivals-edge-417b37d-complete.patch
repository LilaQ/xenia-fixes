+uint32_t D3D12CommandProcessor::BeginDrawTiming(
+    uint64_t vertex_shader, uint64_t pixel_shader, uint32_t surface,
+    uint32_t mode, bool memexport, GpuTimingStage stage) {
+  if (!cvars::d3d12_draw_timing || draw_timing_unavailable_ ||
+      frame_current_ % std::max(1u, cvars::d3d12_draw_timing_interval) || draw_timing_pending_submission_) {
+    return UINT32_MAX;
+  }
+  if (!draw_timing_heap_) {
+    if (!EnsureSubmissionTimingResources()) {
+      draw_timing_unavailable_ = true;
+      return UINT32_MAX;
+    }
+    D3D12_QUERY_HEAP_DESC desc = {};
+    desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    desc.Count = kDrawTimingCapacity * 2;
+    if (FAILED(GetD3D12Provider().GetDevice()->CreateQueryHeap(
+            &desc, IID_PPV_ARGS(&draw_timing_heap_))) ||
+        !CreateReadbackStagingBuffer(draw_timing_readback_,
+                                    kDrawTimingCapacity * 16)) {
+      draw_timing_heap_.Reset();
+      draw_timing_unavailable_ = true;
+      XELOGE("GPU draw timing: timestamp resources unavailable");
+      return UINT32_MAX;
+    }
+    draw_timings_.reserve(kDrawTimingCapacity);
+  }
+  if (cvars::d3d12_draw_statistics && !draw_statistics_heap_) {
+    D3D12_QUERY_HEAP_DESC desc = {};
+    desc.Type = D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS;
+    desc.Count = kDrawTimingCapacity;
+    if (FAILED(GetD3D12Provider().GetDevice()->CreateQueryHeap(
+            &desc, IID_PPV_ARGS(&draw_statistics_heap_))) ||
+        !CreateReadbackStagingBuffer(
+            draw_statistics_readback_,
+            kDrawTimingCapacity *
+                uint32_t(sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS)))) {
+      draw_statistics_heap_.Reset();
+      draw_timing_unavailable_ = true;
+      XELOGE("GPU draw statistics: pipeline query resources unavailable");
+      return UINT32_MAX;
+    }
+  }
+  if (draw_timings_.size() == kDrawTimingCapacity) {
+    return UINT32_MAX;
+  }
+  if (!draw_timing_frame_) {
+    draw_timing_frame_ = frame_current_;
+  }
+  const uint32_t index = uint32_t(draw_timings_.size());
+  draw_timings_.push_back(
+      {vertex_shader, pixel_shader, surface, mode, memexport, stage});
+  deferred_command_list_.D3DEndQuery(draw_timing_heap_.Get(),
+                                    D3D12_QUERY_TYPE_TIMESTAMP, index * 2);
+  if (draw_statistics_heap_) {
+    deferred_command_list_.D3DBeginQuery(draw_statistics_heap_.Get(),
+                                       D3D12_QUERY_TYPE_PIPELINE_STATISTICS,
+                                       index);
+  }
+  return index;
+}
