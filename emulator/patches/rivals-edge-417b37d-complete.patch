+
+void D3D12RenderTargetCache::PollStencilCoverage() {
+  if (!stencil_coverage_pending_submission_ ||
+      stencil_coverage_pending_submission_ >
+          command_processor_.GetCompletedSubmission()) {
+    return;
+  }
+  D3D12_RANGE range = {0,
+                       stencil_coverage_groups_.size() * 9 * sizeof(uint64_t)};
+  void* mapping = nullptr;
+  if (SUCCEEDED(stencil_coverage_readback_->Map(0, &range, &mapping))) {
+    const auto* counts = static_cast<const uint64_t*>(mapping);
+    uint64_t total = 0;
+    bool controls_valid = true;
+    for (size_t i = 0; i < stencil_coverage_groups_.size(); ++i) {
+      uint32_t mask = 0;
+      for (uint32_t bit = 0; bit < 8; ++bit) {
+        uint64_t count = counts[i * 9 + bit];
+        total += count;
+        if (count) {
+          mask |= 1u << bit;
+        }
+      }
+      controls_valid &= counts[i * 9 + 8] == 0;
+      RenderTargetKey source, dest;
+      source.key = stencil_coverage_groups_[i].source;
+      dest.key = stencil_coverage_groups_[i].dest;
+      XELOGI(
+          "GPU stencil coverage: frame {}, {} <= {}, mask {:02X}, "
+          "zero-control samples {}, bit counts [{}, {}, {}, {}, {}, {}, {}, "
+          "{}]",
+          stencil_coverage_frame_, dest.GetDebugName(), source.GetDebugName(),
+          mask, counts[i * 9 + 8], counts[i * 9], counts[i * 9 + 1],
+          counts[i * 9 + 2], counts[i * 9 + 3], counts[i * 9 + 4],
+          counts[i * 9 + 5], counts[i * 9 + 6], counts[i * 9 + 7]);
+    }
+    XELOGI(
+        "GPU stencil coverage summary: {} groups, controls valid {}, "
+        "usable {}, passed samples {}; timing is not a performance measurement",
+        stencil_coverage_groups_.size(), controls_valid,
+        controls_valid && total != 0, total);
+    D3D12_RANGE written = {0, 0};
+    stencil_coverage_readback_->Unmap(0, &written);
+  }
+  stencil_coverage_groups_.clear();
+  stencil_coverage_frame_ = 0;
+  stencil_coverage_pending_submission_ = 0;
+}
