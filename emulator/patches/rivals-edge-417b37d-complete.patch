+void D3D12CommandProcessor::AwaitMemexportSubmission(uint64_t submission) {
+  if (!cvars::d3d12_submission_timing) {
+    CheckSubmissionCompletion(submission);
+    return;
+  }
+  const uint64_t start = xe::Clock::QueryHostTickCount();
+  CheckSubmissionCompletion(submission);
+  const uint64_t ticks = xe::Clock::QueryHostTickCount() - start;
+  ++memexport_cpu_wait_count_;
+  memexport_cpu_wait_ticks_ += ticks;
+  memexport_cpu_wait_max_ticks_ = std::max(memexport_cpu_wait_max_ticks_, ticks);
+}
+
+void D3D12CommandProcessor::PumpRivalsEventFences() {
+  if (rivals_pumping_event_fences_) {
+    return;
+  }
+  rivals_pumping_event_fences_ = true;
+  const uint64_t completed = GetCompletedSubmission();
+  // MarkMemexportPagesWritten installs a new owner for every awaited export.
+  // Once that owner completes, subsequent ordinary event words need no wait.
+  if (!rivals_event_fences_.empty() && memexport_await_pending_ &&
+      memexport_staged_.empty() && memexport_awaited_submission_ <= completed) {
+    memexport_await_pending_ = false;
+  }
+  while (!rivals_event_fences_.empty() &&
+         rivals_event_fences_.front().submission <= completed) {
+    const RivalsEventFence fence = rivals_event_fences_.front();
+    rivals_event_fences_.pop_front();
+    xe::store(memory_->TranslatePhysical(fence.address), fence.value);
+  }
+  rivals_pumping_event_fences_ = false;
+}
+
+bool D3D12CommandProcessor::TryWriteMemexportGpuFence(
+    uint32_t address, uint32_t value) {
+  if (!cvars::d3d12_rivals_gpu_event_fences ||
+      !memexport_await_pending_ || !memexport_staged_.empty() ||
+      !shared_memory_->GetHostBuffer() || trace_writer_.is_open() ||
+      (address & 3) || address > SharedMemory::kBufferSize - 4 ||
+      WritableGuestRangeLength(address, 4) != 4 ||
+      rivals_event_fences_.size() >= 4096) {
+    return false;
+  }
+  auto* kernel = kernel::KernelState::shared();
+  uint32_t title_id = kernel ? kernel->title_id() : 0;
+  if (!title_id) title_id = trace_playback_title_id();
+  if (title_id != 0x454109C6) {
+    return false;
+  }
+  // Preserve the actual awaited export owner. Later, unrelated GPU work
+  // does not extend AwaitMemexportForFence's CPU-visibility dependency.
+  const uint64_t owner = memexport_awaited_submission_;
+  SubmitResolvesForGuestSync();
+  if (owner >= GetCurrentSubmission()) {
+    if (!EndSubmission(false) || owner >= GetCurrentSubmission()) {
+      return false;
+    }
+  }
+  rivals_event_fences_.push_back({owner, address, value});
+  PumpRivalsEventFences();
+  static thread_local uint64_t queued = 0;
+  if (++queued <= 4 ||
+      (cvars::d3d12_submission_timing && !(queued % 240))) {
+    XELOGI("Rivals queued completion fence: {:08X}={:08X}, owner {}",
+           address, value, owner);
+  }
+  return true;
+}
+
+bool D3D12CommandProcessor::TryMemexportGpuCoherency(
+    uint32_t base_bytes, uint32_t size_bytes) {
+  if (!cvars::d3d12_rivals_gpu_atlas_coherency ||
+      !shared_memory_->GetHostBuffer() || !memexport_staged_.empty()) {
+    return false;
+  }
+  auto* kernel = kernel::KernelState::shared();
+  uint32_t title_id = kernel ? kernel->title_id() : 0;
+  if (!title_id) title_id = trace_playback_title_id();
+  if (title_id != 0x454109C6 ||
+      (register_file_->values[XE_GPU_REG_COHER_STATUS_HOST] & 0x7FFFFFFF) !=
+          0x03000200) {
+    return false;
+  }
+  // Live TU2 stacks also wait here for 0x37000-byte intermediate ranges,
+  // not only generated atlases. VC/TC invalidation
+  // prepares GPU consumers; CPU visibility is still guarded by real fences.
+  // Texture loads copy dirty host-buffer ranges to the device buffer, ordered
+  // on this same queue. The caller has verified overlap with exported data.
+  // Transitioning out of UAV orders those writes without draining the GPU.
+  // Keep memexport_await_pending_ and its owner: EVENT_WRITE_SHD / interrupts
+  // must still make the output CPU-visible before the guest observes them.
+  shared_memory_->UseHostAsCopySource();
+  SubmitBarriers();
+  static thread_local uint64_t queued = 0;
+  if (++queued <= 4 ||
+      (cvars::d3d12_submission_timing && !(queued % 240))) {
+    XELOGI("Rivals GPU consumer coherency: {:08X}+{:08X}, CPU fence retained",
+           base_bytes, size_bytes);
+  }
+  return true;
+}
