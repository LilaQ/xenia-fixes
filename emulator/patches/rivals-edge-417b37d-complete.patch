+std::pair<uint32_t, uint32_t> TextureCache::Texture::GetDirtyBaseBytes() {
+  auto lock = texture_cache_.global_critical_region_.Acquire();
+  if (!base_range_tracking_ || dirty_base_first_ == UINT32_MAX)
+    return {0, GetGuestBaseSize()};
+  return {dirty_base_first_, dirty_base_end_};
