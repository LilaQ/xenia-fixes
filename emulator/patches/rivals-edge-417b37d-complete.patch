+  return BeginStageTiming(stencil ? GpuTimingStage::kTransferStencil
+                                 : color ? GpuTimingStage::kTransferColor
+                                         : GpuTimingStage::kTransferDepth);
+}
+
+uint32_t D3D12CommandProcessor::BeginStageTiming(GpuTimingStage stage) {
+  if (!IsGpuStageTimingSample() || !submission_open_) {
+    return UINT32_MAX;
+  }
+  const size_t stream_begin = deferred_command_list_.command_stream_size_bytes();
+  const uint32_t index = BeginDrawTiming(0, 0, 0, 0, false, stage);
+  if (index != UINT32_MAX) {
+    DrawTiming& timing = draw_timings_[index];
+    timing.stage_submission = GetCurrentSubmission();
+    timing.stage_stream_begin = stream_begin;
+    timing.stage_stream_size = deferred_command_list_.command_stream_size_bytes();
+  }
+  return index;
+}
+
+uint32_t D3D12CommandProcessor::BeginTextureLoadTiming(
+    uint32_t base, uint32_t mips, uint32_t width, uint32_t height,
+    uint32_t format) {
+  if (!cvars::d3d12_texture_load_timing || !IsGpuStageTimingSample())
+    return UINT32_MAX;
+  uint32_t index = BeginStageTiming(GpuTimingStage::kTextureUpload);
+  if (index != UINT32_MAX) {
+    auto& timing = draw_timings_[index];
+    timing.vertex_shader = base;
+    timing.pixel_shader = mips;
+    timing.surface = width | (height << 16);
+    timing.mode = format;
+  }
+  return index;
+}
+
+void D3D12CommandProcessor::EndDrawTiming(uint32_t index) {
+  if (index != UINT32_MAX) {
+    DrawTiming& timing = draw_timings_[index];
+    timing.completed = true;
+    if (timing.stage != GpuTimingStage::kDraw) {
+      timing.stage_had_commands =
+          timing.stage_submission != GetCurrentSubmission() ||
+          timing.stage_stream_size !=
+              deferred_command_list_.command_stream_size_bytes();
+      if (!timing.stage_had_commands && index + 1 == draw_timings_.size() &&
+          deferred_command_list_.DiscardTrailingTimestampQuery(
+              timing.stage_stream_begin)) {
+        ++empty_stage_counts_[uint32_t(timing.stage)];
+        draw_timings_.pop_back();
+        return;
+      }
+    }
+    if (draw_statistics_heap_) {
+      deferred_command_list_.D3DEndQuery(draw_statistics_heap_.Get(),
+                                       D3D12_QUERY_TYPE_PIPELINE_STATISTICS,
+                                       index);
+    }
+    deferred_command_list_.D3DEndQuery(draw_timing_heap_.Get(),
+                                      D3D12_QUERY_TYPE_TIMESTAMP, index * 2 + 1);
+  }
+}
+
+void D3D12CommandProcessor::PollDrawTimings() {
+  if (!draw_timing_pending_submission_ ||
+      draw_timing_pending_submission_ > GetCompletedSubmission()) {
+    return;
+  }
+  using Key = std::tuple<uint64_t, uint64_t, uint32_t, uint32_t, bool>;
+  using Value = std::pair<double, uint32_t>;
+  std::map<Key, Value> sums;
+  std::map<Key, Value> texture_sums;
+  std::map<std::pair<GpuTimingStage, bool>, Value> stage_sums;
+  std::map<Key, D3D12_QUERY_DATA_PIPELINE_STATISTICS> statistics;
+  D3D12_QUERY_DATA_PIPELINE_STATISTICS total_statistics = {};
+  const auto* queries = static_cast<const D3D12_QUERY_DATA_PIPELINE_STATISTICS*>(
+      draw_statistics_readback_.mapped);
+  double total_ms = 0;
+  uint32_t draw_count = 0;
+  const auto* ticks = static_cast<const uint64_t*>(draw_timing_readback_.mapped);
+  for (uint32_t i = 0; i < draw_timings_.size(); ++i) {
+    if (ticks[i * 2 + 1] < ticks[i * 2]) {
+      XELOGE("GPU draw timing: invalid timestamps in sample {}", draw_timing_frame_);
+      continue;
+    }
+    const DrawTiming& draw = draw_timings_[i];
+    const double ms = double(ticks[i * 2 + 1] - ticks[i * 2]) *
+                      1000.0 / double(submission_timing_frequency_);
+    if (draw.stage == GpuTimingStage::kTextureUpload) {
+      auto& sum = texture_sums[{draw.vertex_shader, draw.pixel_shader,
+                               draw.surface, draw.mode, false}];
+      sum.first += ms;
+      ++sum.second;
+      continue;
+    }
+    if (draw.stage != GpuTimingStage::kDraw) {
+      auto& sum = stage_sums[{draw.stage, draw.stage_had_commands}];
+      sum.first += ms;
+      ++sum.second;
+      continue;
+    }
+    ++draw_count;
+    const Key key(draw.vertex_shader, draw.pixel_shader, draw.surface,
+                  draw.mode, draw.memexport);
+    if (queries) {
+      auto accumulate = [](D3D12_QUERY_DATA_PIPELINE_STATISTICS& to,
+                           const D3D12_QUERY_DATA_PIPELINE_STATISTICS& from) {
+        to.IAVertices += from.IAVertices;
+        to.IAPrimitives += from.IAPrimitives;
+        to.VSInvocations += from.VSInvocations;
+        to.GSInvocations += from.GSInvocations;
+        to.GSPrimitives += from.GSPrimitives;
+        to.CInvocations += from.CInvocations;
+        to.CPrimitives += from.CPrimitives;
+        to.PSInvocations += from.PSInvocations;
+      };
+      accumulate(statistics[key], queries[i]);
+      accumulate(total_statistics, queries[i]);
+    }
+    auto& sum = sums[key];
+    sum.first += ms;
+    ++sum.second;
+    total_ms += ms;
+  }
+  std::vector<std::pair<Key, Value>> sorted(sums.begin(), sums.end());
+  std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) {
+    return a.second.first > b.second.first;
+  });
+  XELOGI("GPU draw timing: sample frame {}, {} draws, sum {:.3f} ms{}",
+         draw_timing_frame_, draw_count, total_ms,
+         draw_timings_.size() == kDrawTimingCapacity ? " (capacity reached)" : "");
+  if (queries) {
+    XELOGI("GPU draw statistics: frame {}, IA vertices {}, IA primitives {}, "
+           "VS {}, GS {}, GS primitives {}, clip {}, clipped primitives {}, "
+           "PS {}. Instrumented sample; not a gameplay frame-time result.",
+           draw_timing_frame_, total_statistics.IAVertices,
+           total_statistics.IAPrimitives, total_statistics.VSInvocations,
+           total_statistics.GSInvocations, total_statistics.GSPrimitives,
+           total_statistics.CInvocations, total_statistics.CPrimitives,
+           total_statistics.PSInvocations);
+  }
+  for (size_t i = 0; i < std::min(sorted.size(), size_t(8)); ++i) {
+    const auto& key = sorted[i].first;
+    const auto& value = sorted[i].second;
+    XELOGI("GPU draw timing: VS {:016X} PS {:016X}, pitch {}, samples {}, "
+           "mode {}, memexport {}: {:.3f} ms in {} draws",
+           std::get<0>(key), std::get<1>(key), std::get<2>(key) & 0x3FFF,
+           1u << ((std::get<2>(key) >> 16) & 3), std::get<3>(key),
+           std::get<4>(key), value.first, value.second);
+    if (queries) {
+      const auto& count = statistics.at(key);
+      XELOGI("GPU draw statistics: VS {:016X} PS {:016X}: VS {}, GS {}, "
+             "clip {}, PS {}", std::get<0>(key), std::get<1>(key),
+             count.VSInvocations, count.GSInvocations, count.CInvocations,
+             count.PSInvocations);
+    }
+  }
+  std::vector<std::pair<Key, Value>> texture_sorted(texture_sums.begin(),
+                                                    texture_sums.end());
+  std::sort(texture_sorted.begin(), texture_sorted.end(),
+            [](const auto& a, const auto& b) { return a.second.first > b.second.first; });
+  for (size_t i = 0; i < texture_sorted.size(); ++i) {
+    const auto& [key, value] = texture_sorted[i];
+    if (i >= 16 && !(std::get<3>(key) >> 16)) continue;
+    XELOGI("GPU texture timing: base {:08X}, mips {:08X}, {}x{}, format {}: {:.3f} ms in {} uploads",
+           std::get<0>(key), std::get<1>(key), std::get<2>(key) & 65535,
+           std::get<2>(key) >> 16, std::get<3>(key), value.first, value.second);
+  }
+  for (const auto& [stage, value] : stage_sums) {
+    const char* name = "unknown";
+    switch (stage.first) {
+      case GpuTimingStage::kRenderTargets: name = "render targets"; break;
+      case GpuTimingStage::kTextures: name = "textures"; break;
+      case GpuTimingStage::kBarriers: name = "barriers"; break;
+      case GpuTimingStage::kResolve: name = "resolve"; break;
+      case GpuTimingStage::kTransferDepth: name = "transfer depth"; break;
+      case GpuTimingStage::kTransferStencil: name = "transfer stencil"; break;
+      case GpuTimingStage::kTransferColor: name = "transfer color"; break;
+      default: break;
+    }
+    XELOGI("GPU stage timing: frame {}, {}, {}: {:.3f} ms in {} intervals "
+           "(inclusive; nested intervals overlap)", draw_timing_frame_, name,
+           stage.second ? "with GPU commands" : "empty interval",
+           value.first, value.second);
+  }
+  if (cvars::d3d12_stage_timing) {
+    XELOGI("GPU empty stage intervals omitted: frame {}, render targets {}, "
+           "textures {}, barriers {}, resolve {}", draw_timing_frame_,
+           empty_stage_counts_[1], empty_stage_counts_[2],
+           empty_stage_counts_[3], empty_stage_counts_[4]);
+  }
+  empty_stage_counts_ = {};
+  draw_timings_.clear();
+  draw_timing_frame_ = 0;
+  draw_timing_pending_submission_ = 0;
+  draw_timing_resolved_ = 0;
+}
+
+bool D3D12CommandProcessor::EnsureSubmissionTimingResources() {
+  if (submission_timing_heap_) {
+    return true;
+  }
+  if (submission_timing_unavailable_) {
+    return false;
+  }
+  const auto& provider = GetD3D12Provider();
+  D3D12_QUERY_HEAP_DESC desc = {};
+  desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  desc.Count = kSubmissionTimingSlots * 2;
+  if (FAILED(provider.GetDirectQueue()->GetTimestampFrequency(
+          &submission_timing_frequency_)) || !submission_timing_frequency_ ||
+      FAILED(provider.GetDevice()->CreateQueryHeap(
+          &desc, IID_PPV_ARGS(&submission_timing_heap_))) ||
+      !CreateReadbackStagingBuffer(submission_timing_readback_,
+                                  kSubmissionTimingSlots * 16)) {
+    submission_timing_heap_.Reset();
+    submission_timing_unavailable_ = true;
+    XELOGE("GPU timing: timestamp resources unavailable");
+    return false;
+  }
+  XELOGI("GPU timing: hardware timestamps enabled ({} ticks/s)",
+         submission_timing_frequency_);
+  return true;
+}
+
+void D3D12CommandProcessor::PollSubmissionTimings() {
+  if (!submission_timing_readback_.mapped) {
+    return;
+  }
+  const uint64_t completed = GetCompletedSubmission();
+  const auto* timestamps =
+      static_cast<const uint64_t*>(submission_timing_readback_.mapped);
+  while (!submission_timings_.empty() &&
+         submission_timings_.front().submission <= completed) {
+    const SubmissionTiming timing = submission_timings_.front();
+    submission_timings_.pop_front();
+    const uint64_t begin = timestamps[timing.slot * 2];
+    const uint64_t end = timestamps[timing.slot * 2 + 1];
+    submission_timing_in_use_[timing.slot] = 0;
+    if (end >= begin) {
+      submission_timing_frame_ms_ +=
+          double(end - begin) * 1000.0 / double(submission_timing_frequency_);
+    }
+    if (timing.ends_frame) {
+      submission_timing_total_ms_ += submission_timing_frame_ms_;
+      submission_timing_max_ms_ =
+          std::max(submission_timing_max_ms_, submission_timing_frame_ms_);
+      submission_timing_frame_ms_ = 0;
+      submission_timing_skipped_ += timing.skipped_draws;
+      submission_timing_wall_total_ms_ += timing.frame_wall_ms;
+      if (++submission_timing_frames_ == 120) {
+        const double ticks_to_ms =
+            1000.0 / double(xe::Clock::QueryHostTickFrequency());
+        XELOGI("CPU memexport dependencies: {} calls / 120 frames, {:.3f} ms "
+               "total, {:.3f} ms max (includes submission and GPU wait)",
+               memexport_cpu_wait_count_,
+               double(memexport_cpu_wait_ticks_) * ticks_to_ms,
+               double(memexport_cpu_wait_max_ticks_) * ticks_to_ms);
+        memexport_cpu_wait_count_ = 0;
+        memexport_cpu_wait_ticks_ = 0;
+        memexport_cpu_wait_max_ticks_ = 0;
+        XELOGI("GPU timing: through frame {}, frame avg {:.3f} ms, "
+               "GPU submissions avg {:.3f} ms, max {:.3f} ms; "
+               "no-output draws skipped avg {:.1f}/frame",
+               timing.frame, submission_timing_wall_total_ms_ / 120.0,
+               submission_timing_total_ms_ / 120.0, submission_timing_max_ms_,
+               double(submission_timing_skipped_) / 120.0);
+        submission_timing_frames_ = 0;
+        submission_timing_total_ms_ = 0;
+        submission_timing_wall_total_ms_ = 0;
+        submission_timing_max_ms_ = 0;
+        submission_timing_skipped_ = 0;
+      }
+    }
+  }
+}
