+uint32_t D3D12RenderTargetCache::BeginStencilCoverageGroup(
+    RenderTargetKey source, RenderTargetKey dest) {
+  if (!cvars::d3d12_stencil_bit_coverage ||
+      !command_processor_.IsGpuStageTimingSample() ||
+      cvars::occlusion_query != "fake" ||
+      cvars::no_discard_stencil_in_transfer_pipelines ||
+      stencil_coverage_pending_submission_ || stencil_coverage_failed_ ||
+      stencil_coverage_groups_.size() >= kStencilCoverageQueryCount / 9) {
+    return UINT32_MAX;
+  }
+  if (!stencil_coverage_heap_) {
+    ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+    D3D12_QUERY_HEAP_DESC heap = {};
+    heap.Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION;
+    heap.Count = kStencilCoverageQueryCount;
+    if (FAILED(device->CreateQueryHeap(
+            &heap, IID_PPV_ARGS(stencil_coverage_heap_.GetAddressOf())))) {
+      stencil_coverage_failed_ = true;
+      XELOGE("GPU stencil coverage: query heap unavailable");
+      return UINT32_MAX;
+    }
+    D3D12_RESOURCE_DESC buffer;
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer, uint64_t(kStencilCoverageQueryCount) * sizeof(uint64_t),
+        D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE,
+            &buffer, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(stencil_coverage_readback_.GetAddressOf())))) {
+      stencil_coverage_heap_.Reset();
+      stencil_coverage_failed_ = true;
+      XELOGE("GPU stencil coverage: readback buffer unavailable");
+      return UINT32_MAX;
+    }
+  }
+  if (stencil_coverage_groups_.empty()) {
+    stencil_coverage_frame_ = command_processor_.GetCurrentFrame();
+  }
+  if (stencil_coverage_frame_ != command_processor_.GetCurrentFrame()) {
+    return UINT32_MAX;
+  }
+  uint32_t first = uint32_t(stencil_coverage_groups_.size() * 9);
+  stencil_coverage_groups_.push_back({source.key, dest.key});
+  return first;
+}
