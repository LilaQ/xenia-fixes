diff --git a/src/xenia/kernel/xam/avatars/compression.cc b/src/xenia/kernel/xam/avatars/compression.cc
new file mode 100644
--- /dev/null
+++ b/src/xenia/kernel/xam/avatars/compression.cc
@@ -0,0 +1,83 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "compression.h"
+#include "xenia/cpu/lzx.h"
+
+#include "xe_compat.h"
+
+namespace xe {
+namespace avatars {
+namespace compression {
+
+struct BlockHeader {
+  le<uint32_t> compressed_size;
+  le<uint32_t> uncompressed_offset;
+  le<uint32_t> uncompressed_size;
+};
+static_assert_size(BlockHeader, 12);
+
+// Block headers come from closet .bin blobs (marketplace/award rips), which
+// can be truncated or corrupt, so every field is bounds-checked in release
+// builds too: an unchecked compressed_size walks the LZX bit reader off the
+// end of the blob.
+
+bool GetUncompressedSize(const uint8_t* input_buffer, size_t input_size,
+                         size_t& output_size) {
+  if (input_size < sizeof(BlockHeader)) {
+    return false;
+  }
+  output_size = 0;
+  size_t offset = 0;
+  while (offset + sizeof(BlockHeader) <= input_size) {
+    const auto& block_header = *(BlockHeader*)&input_buffer[offset];
+    offset += sizeof(BlockHeader);
+    if (block_header.compressed_size > input_size - offset) {
+      return false;  // compressed data extends past the blob
+    }
+    output_size += block_header.uncompressed_size;
+    offset += block_header.compressed_size;
+  }
+  return true;
+}
+
+bool Decompress(const uint8_t* input_buffer, size_t input_size,
+                uint8_t* output_buffer, size_t output_size) {
+  if (input_size < sizeof(BlockHeader)) {
+    return false;
+  }
+  size_t input_offset = 0;
+  size_t output_offset = 0;
+  while (input_offset + sizeof(BlockHeader) <= input_size) {
+    const auto& block_header = *(BlockHeader*)&input_buffer[input_offset];
+    input_offset += sizeof(BlockHeader);
+
+    if (block_header.compressed_size > input_size - input_offset ||
+        block_header.uncompressed_size > output_size - output_offset ||
+        output_offset != block_header.uncompressed_offset) {
+      return false;  // malformed header: would read/write out of bounds
+    }
+
+    auto result = lzx_decompress(
+        &input_buffer[input_offset], block_header.compressed_size,
+        &output_buffer[output_offset], block_header.uncompressed_size, 0x8000,
+        nullptr, 0);
+    if (result) {
+      return false;
+    }
+
+    input_offset += block_header.compressed_size;
+    output_offset += block_header.uncompressed_size;
+  }
+  return true;
+}
+
+}  // namespace compression
+}  // namespace avatars
+}  // namespace xe
