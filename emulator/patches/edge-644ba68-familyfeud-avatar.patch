+static std::vector<uint8_t> ReadAvatarFile(const std::string& path) {
+  if (path.empty()) return {};
+  FILE* file = std::fopen(path.c_str(), "rb");
+  if (!file) return {};
+  std::fseek(file, 0, SEEK_END);
+  const auto length = std::ftell(file);
+  std::rewind(file);
+  std::vector<uint8_t> bytes;
+  if (length > 0 && length < 64 * 1024 * 1024) {
+    bytes.resize(size_t(length));
+    if (std::fread(bytes.data(), 1, bytes.size(), file) != bytes.size()) bytes.clear();
+  }
+  std::fclose(file);
+  return bytes;
+}
+
+static std::vector<uint8_t> ReadTitleFile(const std::string& path) {
+  auto* entry = kernel_state()->file_system()->ResolvePath(path);
+  if (!entry || entry->size() > 64 * 1024 * 1024) return {};
+  vfs::File* file = nullptr;
+  if (entry->Open(vfs::FileAccess::kFileReadData, &file) != X_STATUS_SUCCESS) {
+    return {};
+  }
+  std::vector<uint8_t> bytes(entry->size());
+  size_t count = 0;
+  const X_STATUS status = file->ReadSync(
+      std::span<uint8_t>(bytes.data(), bytes.size()), 0, &count);
+  file->Destroy();
+  if (status != X_STATUS_SUCCESS || count != bytes.size()) return {};
+  return bytes;
+}
