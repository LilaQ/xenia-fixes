+static std::vector<uint8_t> ReadPackFromPirs(const std::vector<uint8_t>& package) {
+  if (package.size() < 0xD000 ||
+      (std::memcmp(package.data(), "PIRS", 4) &&
+       std::memcmp(package.data(), "LIVE", 4) &&
+       std::memcmp(package.data(), "CON ", 4))) return {};
+  const auto u16be = [&](size_t p) { return uint32_t(package[p]) << 8 | package[p + 1]; };
+  const auto u32be = [&](size_t p) {
+    return uint32_t(package[p]) << 24 | uint32_t(package[p + 1]) << 16 |
+           uint32_t(package[p + 2]) << 8 | package[p + 3];
+  };
+  const size_t data_start = u16be(0xC032) == 0xFFFF ? 0xC000 : 0xD000;
+  const size_t hash_offset = data_start == 0xC000 ? 0x1000 : 0x2000;
+  const size_t table_end = std::min(package.size(), data_start + 0x1000 * 16);
+  for (size_t p = data_start; p + 64 <= table_end; p += 64) {
+    const size_t name_length = package[p + 40] & 0x3F;
+    if (!name_length) break;
+    if (name_length != 19 ||
+        std::memcmp(package.data() + p, "AvatarAssetPack.toc", 19)) continue;
+    if (!(package[p + 40] & 0x40)) return {};  // contiguous STFS file
+    const uint32_t start_block = uint32_t(package[p + 47]) |
+                                 uint32_t(package[p + 48]) << 8 |
+                                 uint32_t(package[p + 49]) << 16;
+    const uint32_t size = u32be(p + 52);
+    if (!size || size > 64 * 1024 * 1024) return {};
+    std::vector<uint8_t> toc(size);
+    for (size_t i = 0; i < (size + 0xFFF) / 0x1000; ++i) {
+      const size_t block = size_t(start_block) + i;
+      size_t adjusted = block;
+      size_t hash_bytes = 0;
+      while (adjusted >= 170) {
+        adjusted /= 170;
+        hash_bytes += (adjusted + 1) * hash_offset;
+      }
+      const size_t input = data_start + block * 0x1000 + hash_bytes;
+      const size_t output = i * 0x1000;
+      const size_t count = std::min(size_t(0x1000), size_t(size) - output);
+      if (input > package.size() || count > package.size() - input) return {};
+      std::memcpy(toc.data() + output, package.data() + input, count);
+    }
+    return toc;
+  }
+  return {};
+}
+
+static bool EnsureAvatarPack() {
+  const uint32_t title_id = kernel_state()->title_id();
+  if (avatar_pack_title_id != title_id) {
+    avatar_pack = avatars::AssetPack{};
+    avatar_pack_title_id = title_id;
+  }
+  if (avatar_pack.is_loaded()) return true;
+  auto bytes = ReadAvatarFile(cvars::avatar_asset_pack_path);
+  if (bytes.empty()) bytes = ReadPackFromPirs(ReadTitleFile("GAME:\\AvatarAssetPack"));
+  if (bytes.empty()) return false;
+  return avatar_pack.Load(bytes);
+}
