+std::shared_ptr<Skeleton> LoadSkeleton(uint32_t skeleton_version,
+                                       SkeletonLoadOptions load_options) {
+  if (skeleton_version == 1) {
+    return Skeleton::Read(skeleton_nxe, countof(skeleton_nxe), load_options);
+  } else if (skeleton_version == 2) {
+    return Skeleton::Read(skeleton_kinect, countof(skeleton_kinect),
+                          load_options);
+  }
+  return nullptr;
