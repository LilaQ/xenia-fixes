+void KernelState::QueueHostDispatch(std::function<void()> callback) {
+  {
+    std::lock_guard lock(dispatch_mutex_);
+    dispatch_queue_.push_back(std::move(callback));
+  }
+  dispatch_cond_.notify_all();
+}
