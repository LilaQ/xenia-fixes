--- a/src/xenia/gpu/trace_player.cc
+++ b/src/xenia/gpu/trace_player.cc
@@ -196,2 +196,17 @@
-          command_processor->ExecutePacket(pending_packet->base_ptr,
-                                           pending_packet->count);
+          // A one-word trace marker can originate from a skipped padding word.
+          // At a wrapped ring boundary older recorders copied the preceding
+          // page's final dword instead. Such a marker has no payload or effect;
+          // never interpret those unrelated bytes as a register-write packet.
+          const uint32_t header = xe::load_and_swap<uint32_t>(
+              reinterpret_cast<const uint8_t*>(pending_packet) +
+              sizeof(PacketStartCommand));
+          const uint32_t type = header >> 30;
+          const bool invalid_padding_marker = pending_packet->count == 1 &&
+              ((type == 0 && header != 0) || type == 1 || type == 3);
+          if (invalid_padding_marker) {
+            XELOGW("Replay: skipped malformed one-word padding marker at {:08X}",
+                   pending_packet->base_ptr);
+          } else {
+            command_processor->ExecutePacket(pending_packet->base_ptr,
+                                             pending_packet->count);
+          }
