+bool D3D12CommandProcessor::TryWriteMemexportGpuFence(
+    uint32_t address, uint32_t value) {
+  if (!cvars::d3d12_rivals_gpu_event_fences ||
+      !memexport_await_pending_ || !memexport_staged_.empty() ||
+      !shared_memory_->GetHostBuffer() || trace_writer_.is_open() ||
+      (address & 3) || address > SharedMemory::kBufferSize - 4 ||
+      WritableGuestRangeLength(address, 4) != 4 ||
+      rivals_event_fences_.size() >= 4096) {
+    return false;
+  }
+  auto* kernel = kernel::KernelState::shared();
+  uint32_t title_id = kernel ? kernel->title_id() : 0;
+  if (!title_id) title_id = trace_playback_title_id();
+  if (title_id != 0x454109C6) {
+    return false;
+  }
+  SubmitResolvesForGuestSync();
+  if (!EndSubmission(false)) {
+    return false;
+  }
+  // No empty submissions or GPU buffer copies for consecutive event words.
+  // Publish each value only when the timeline proves all preceding exports
+  // complete; command parsing can continue until then.
+  const uint64_t owner = GetCurrentSubmission() - 1;
+  rivals_event_fences_.push_back({owner, address, value});
+  memexport_awaited_submission_ = owner;
+  PumpRivalsEventFences();
+  static thread_local uint64_t queued = 0;
+  if (++queued <= 4 ||
+      (cvars::d3d12_submission_timing && !(queued % 240))) {
+    XELOGI("Rivals queued completion fence: {:08X}={:08X}, owner {}",
+           address, value, owner);
+  }
+  return true;
+}
