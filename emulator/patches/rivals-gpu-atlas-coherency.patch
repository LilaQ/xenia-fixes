+void D3D12CommandProcessor::AwaitMemexportSubmission(uint64_t submission) {
+  if (!cvars::d3d12_submission_timing) {
+    CheckSubmissionCompletion(submission);
+    return;
+  }
+  const uint64_t start = xe::Clock::QueryHostTickCount();
+  CheckSubmissionCompletion(submission);
+  const uint64_t ticks = xe::Clock::QueryHostTickCount() - start;
+  ++memexport_cpu_wait_count_;
+  memexport_cpu_wait_ticks_ += ticks;
+  memexport_cpu_wait_max_ticks_ = std::max(memexport_cpu_wait_max_ticks_, ticks);
+}
+
+bool D3D12CommandProcessor::TryMemexportGpuCoherency(
+    uint32_t base_bytes, uint32_t size_bytes) {
+  if (!cvars::d3d12_rivals_gpu_atlas_coherency ||
+      !shared_memory_->GetHostBuffer() || !memexport_staged_.empty() ||
+      size_bytes != 0x00800000 ||
+      (base_bytes != 0x0CCA6000 && base_bytes != 0x0D4A6000)) {
+    return false;
+  }
+  auto* kernel = kernel::KernelState::shared();
+  uint32_t title_id = kernel ? kernel->title_id() : 0;
+  if (!title_id) title_id = trace_playback_title_id();
+  if (title_id != 0x454109C6 ||
+      (register_file_->values[XE_GPU_REG_COHER_STATUS_HOST] & 0x7FFFFFFF) !=
+          0x03000200) {
+    return false;
+  }
+  // The captured TU2 packets flush VC/TC for an 8 MB generated atlas and
+  // immediately sample it on the GPU. The texture-load path copies its dirty
+  // host-buffer ranges to the device buffer, ordered on this same queue.
+  // Transitioning out of UAV orders those writes without draining the GPU.
+  // Keep memexport_await_pending_ and its owner: EVENT_WRITE_SHD / interrupts
+  // must still make the output CPU-visible before the guest observes them.
+  shared_memory_->UseHostAsCopySource();
+  SubmitBarriers();
+  static thread_local uint64_t queued = 0;
+  if (++queued <= 4 || !(queued % 240)) {
+    XELOGI("Rivals GPU atlas coherency: {:08X}+{:08X}, CPU fence retained",
+           base_bytes, size_bytes);
+  }
+  return true;
+}
