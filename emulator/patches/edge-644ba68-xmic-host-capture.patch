+// USB XMic frames are 1 ms of mono 48 kHz, 16-bit little-endian PCM. miniaudio
+// converts the selected host input to the requested rate and channel count.
+class MicCapture {
+ public:
+  static constexpr uint32_t kSampleRate = 48000;
+  static constexpr uint32_t kSamplesPerFrame = 48;
+  static constexpr uint32_t kBytesPerFrame = kSamplesPerFrame * 2;
+
+  ~MicCapture() {
+    if (device_initialized_) {
+      ma_device_uninit(&device_);
+    }
+    if (context_initialized_) {
+      ma_context_uninit(&context_);
+    }
+  }
+
+  bool Available() {
+    std::lock_guard lock(control_mutex_);
+    if (device_initialized_) {
+      return true;
+    }
+    if (std::chrono::steady_clock::now() < retry_after_) {
+      return false;
+    }
+    if (!context_initialized_) {
+      if (ma_context_init(nullptr, 0, nullptr, &context_) != MA_SUCCESS) {
+        XELOGW("XMic: failed to initialize audio capture context");
+        retry_after_ =
+            std::chrono::steady_clock::now() + std::chrono::seconds(3);
+        return false;
+      }
+      context_initialized_ = true;
+    }
+
+    ma_device_config config = ma_device_config_init(ma_device_type_capture);
+    config.capture.format = ma_format_s16;
+    config.capture.channels = 1;
+    config.sampleRate = kSampleRate;
+    config.dataCallback = [](ma_device* device, void*, const void* input,
+                             ma_uint32 frame_count) {
+      if (input) {
+        static_cast<MicCapture*>(device->pUserData)
+            ->Push(static_cast<const int16_t*>(input), frame_count);
+      }
+    };
+    config.pUserData = this;
+
+    ma_device_info* playback = nullptr;
+    ma_device_info* capture = nullptr;
+    ma_uint32 playback_count = 0;
+    ma_uint32 capture_count = 0;
+    ma_device_id selected_id{};
+    std::string selected_name;
+    if (ma_context_get_devices(&context_, &playback, &playback_count, &capture,
+                               &capture_count) == MA_SUCCESS) {
+      const std::string filter =
+          cvars::mic_device_name.empty() ? "usb" : cvars::mic_device_name;
+      auto lowercase = [](std::string value) {
+        std::transform(value.begin(), value.end(), value.begin(),
+                       [](unsigned char c) { return std::tolower(c); });
+        return value;
+      };
+      const std::string wanted = lowercase(filter);
+      for (ma_uint32 i = 0; i < capture_count; ++i) {
+        if (lowercase(capture[i].name).find(wanted) != std::string::npos) {
+          selected_id = capture[i].id;
+          selected_name = capture[i].name;
+          config.capture.pDeviceID = &selected_id;
+          break;
+        }
+      }
+      if (!cvars::mic_device_name.empty() && selected_name.empty()) {
+        XELOGW("XMic: capture device '{}' not found; using system default",
+               cvars::mic_device_name);
+      }
+    }
+    if (ma_device_init(&context_, &config, &device_) != MA_SUCCESS) {
+      XELOGW("XMic: no usable host capture device");
+      retry_after_ = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+      return false;
+    }
+    device_initialized_ = true;
+    XELOGI("XMic: selected capture device {}",
+           selected_name.empty() ? "(system default)" : selected_name);
+    return true;
+  }
+
+  bool Start() {
+    if (!Available()) {
+      return false;
+    }
+    std::lock_guard lock(control_mutex_);
+    if (running_) {
+      return true;
+    }
+    {
+      std::lock_guard samples_lock(samples_mutex_);
+      read_ = write_ = 0;
+    }
+    if (ma_device_start(&device_) != MA_SUCCESS) {
+      XELOGW("XMic: failed to start host capture");
+      return false;
+    }
+    running_ = true;
+    XELOGI("XMic: host capture started ({} Hz, mono, 16-bit)", kSampleRate);
+    return true;
+  }
+
+  void Stop() {
+    std::lock_guard lock(control_mutex_);
+    if (running_) {
+      ma_device_stop(&device_);
+      running_ = false;
+      samples_ready_.notify_all();
+    }
+  }
+
+  bool running() const { return running_; }
+
+  bool Read(uint32_t frame_count,
+            std::array<uint8_t, 8 * kBytesPerFrame>& out,
+            uint32_t* peak = nullptr) {
+    const size_t count = frame_count * kSamplesPerFrame;
+    std::unique_lock lock(samples_mutex_);
+    if (!samples_ready_.wait_for(lock, std::chrono::milliseconds(250), [&]() {
+          return write_ - read_ >= count || !running_;
+        })) {
+      return false;
+    }
+    if (!running_ || write_ - read_ < count) {
+      return false;
+    }
+    uint32_t max_amplitude = 0;
+    for (size_t i = 0; i < count; ++i) {
+      const int32_t signed_sample = samples_[read_++ % samples_.size()];
+      max_amplitude = std::max(max_amplitude,
+                               static_cast<uint32_t>(signed_sample < 0
+                                                         ? -signed_sample
+                                                         : signed_sample));
+      const uint16_t sample = static_cast<uint16_t>(signed_sample);
+      out[i * 2] = static_cast<uint8_t>(sample);
+      out[i * 2 + 1] = static_cast<uint8_t>(sample >> 8);
+    }
+    if (peak) {
+      *peak = max_amplitude;
+    }
+    return true;
+  }
+
+ private:
+  void Push(const int16_t* input, ma_uint32 count) {
+    std::lock_guard lock(samples_mutex_);
+    for (ma_uint32 i = 0; i < count; ++i) {
+      samples_[write_++ % samples_.size()] = input[i];
+    }
+    if (write_ - read_ > samples_.size()) {
+      read_ = write_ - samples_.size();
+    }
+    samples_ready_.notify_all();
+  }
+
+  std::mutex control_mutex_;
+  std::mutex samples_mutex_;
+  std::condition_variable samples_ready_;
+  std::array<int16_t, kSampleRate> samples_{};
+  size_t read_ = 0;
+  size_t write_ = 0;
+  ma_context context_{};
+  ma_device device_{};
+  bool context_initialized_ = false;
+  bool device_initialized_ = false;
+  std::atomic<bool> running_{false};
+  std::chrono::steady_clock::time_point retry_after_{};
+};
+
+MicCapture& mic_capture() {
+  static MicCapture capture;
+  return capture;
+}

