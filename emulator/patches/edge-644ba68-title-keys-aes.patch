+dword_result_t XeKeysSetKey_entry(dword_t key_num, lpvoid_t key_buffer,
+                                  dword_t key_size) {
+  if (key_num < 0xE0 || key_num >= 0xE0 + KernelState::kTitleKeyCount ||
+      !key_buffer || key_size != KernelState::kTitleKeySize) {
+    return X_STATUS_INVALID_PARAMETER;
+  }
+
+  std::array<uint8_t, KernelState::kTitleKeySize> clear_key;
+  const uint8_t* obscured_key = key_buffer.as<uint8_t*>();
+  bool harmonix_key = false;
+  for (size_t i = 0; i < std::size(kHarmonixObscuredKeys); ++i) {
+    if (std::memcmp(obscured_key, kHarmonixObscuredKeys[i],
+                    clear_key.size()) == 0) {
+      std::memcpy(clear_key.data(), kHarmonixClearKeys[i], clear_key.size());
+      harmonix_key = true;
+      break;
+    }
+  }
+  if (!harmonix_key) {
+    XECRYPT_AES_STATE obfuscation_state;
+    XeCryptAesKey(&obfuscation_state, xe_key_obfuscation_key);
+    XeCryptAesEcb(&obfuscation_state, obscured_key, clear_key.data(), false);
+  }
+
+  uint32_t slot = key_num - 0xE0;
+  KernelState::shared()->SetTitleKey(slot, clear_key.data());
+  XELOGI("XeKeysSetKey: title slot {} installed ({})", slot,
+         harmonix_key ? "Harmonix MOGG" : "console obfuscation key");
+  return X_STATUS_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT1(XeKeysSetKey, kNone, kImplemented);
+
+dword_result_t XeKeysAesCbc_entry(dword_t key_num, lpvoid_t input,
+                                  dword_t input_size, lpvoid_t output,
+                                  lpvoid_t feed, dword_t encrypt) {
+  if (key_num < 0xE0 || key_num >= 0xE0 + KernelState::kTitleKeyCount ||
+      (input_size && (!input || !output)) || (input_size & 15)) {
+    return X_STATUS_INVALID_PARAMETER;
+  }
+
+  std::array<uint8_t, KernelState::kTitleKeySize> key;
+  if (!KernelState::shared()->GetTitleKey(key_num - 0xE0, key.data())) {
+    XELOGW("XeKeysAesCbc: title key {:X} has not been installed",
+           static_cast<uint32_t>(key_num));
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  if (input_size) {
+    XECRYPT_AES_STATE state;
+    XeCryptAesKey(&state, key.data());
+    uint8_t zero_feed[16] = {};
+    XeCryptAesCbc(&state, input.as<uint8_t*>(), input_size,
+                  output.as<uint8_t*>(), feed ? feed.as<uint8_t*>() : zero_feed,
+                  encrypt != 0);
+  }
+  return X_STATUS_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT1(XeKeysAesCbc, kNone, kImplemented);
