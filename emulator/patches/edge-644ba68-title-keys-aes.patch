+bool KernelState::SetTitleKey(uint32_t slot, const uint8_t* key) {
+  if (slot >= kTitleKeyCount || !key) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(title_keys_mutex_);
+  std::memcpy(title_keys_[slot].data(), key, kTitleKeySize);
+  title_key_valid_[slot] = true;
+  return true;
+}
+
+bool KernelState::GetTitleKey(uint32_t slot, uint8_t* key) {
+  if (slot >= kTitleKeyCount || !key) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(title_keys_mutex_);
+  if (!title_key_valid_[slot]) {
+    return false;
+  }
+  std::memcpy(key, title_keys_[slot].data(), kTitleKeySize);
+  return true;
+}
