+uint32_t D3D12CommandProcessor::BeginTextureLoadTiming(
+    uint32_t base, uint32_t mips, uint32_t width, uint32_t height,
+    uint32_t format) {
+  if (!cvars::d3d12_texture_load_timing || !IsGpuStageTimingSample())
+    return UINT32_MAX;
+  uint32_t index = BeginStageTiming(GpuTimingStage::kTextureUpload);
+  if (index != UINT32_MAX) {
+    auto& timing = draw_timings_[index];
+    timing.vertex_shader = base;
+    timing.pixel_shader = mips;
+    timing.surface = width | (height << 16);
+    timing.mode = format;
+  }
+  return index;
+}
