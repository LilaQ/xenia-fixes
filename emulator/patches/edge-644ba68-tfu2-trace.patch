+uint32_t D3D12CommandProcessor::BeginTraceDrawTiming(
+    uint64_t vs, uint64_t ps, uint32_t vertices, uint32_t surface) {
+  if (!cvars::trace_draw_timing || trace_draw_timing_unavailable_ ||
+      trace_draw_timings_.size() >= kTraceDrawTimingCapacity) {
+    return UINT32_MAX;
+  }
+  if (!trace_draw_timing_heap_) {
+    D3D12_QUERY_HEAP_DESC desc = {};
+    desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    desc.Count = kTraceDrawTimingCapacity * 2;
+    if (FAILED(GetD3D12Provider().GetDevice()->CreateQueryHeap(
+            &desc, IID_PPV_ARGS(&trace_draw_timing_heap_))) ||
+        FAILED(GetD3D12Provider().GetDirectQueue()->GetTimestampFrequency(
+            &trace_draw_timing_frequency_)) ||
+        !trace_draw_timing_frequency_ ||
+        !CreateReadbackStagingBuffer(trace_draw_timing_readback_,
+                                    kTraceDrawTimingCapacity * 16)) {
+      trace_draw_timing_unavailable_ = true;
+      XELOGW("Trace GPU timestamps unavailable; no timing recorded");
+      return UINT32_MAX;
+    }
+    trace_draw_timings_.reserve(kTraceDrawTimingCapacity);
+  }
+  uint32_t slot = uint32_t(trace_draw_timings_.size());
+  trace_draw_timings_.push_back({frame_current_, vs, ps, vertices, surface});
+  deferred_command_list_.D3DEndQuery(trace_draw_timing_heap_.Get(),
+                                    D3D12_QUERY_TYPE_TIMESTAMP, slot * 2);
+  return slot;
+}
+
+void D3D12CommandProcessor::EndTraceDrawTiming(uint32_t slot) {
+  if (slot == UINT32_MAX) {
+    return;
+  }
+  deferred_command_list_.D3DEndQuery(trace_draw_timing_heap_.Get(),
+                                    D3D12_QUERY_TYPE_TIMESTAMP, slot * 2 + 1);
+}
+
+void D3D12CommandProcessor::ResolveTraceDrawTimings() {
+  uint32_t end = uint32_t(trace_draw_timings_.size());
+  if (!trace_draw_timing_heap_ || end == trace_draw_timing_resolved_) {
+    return;
+  }
+  deferred_command_list_.D3DResolveQueryData(
+      trace_draw_timing_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+      trace_draw_timing_resolved_ * 2,
+      (end - trace_draw_timing_resolved_) * 2,
+      trace_draw_timing_readback_.resource.Get(),
+      uint64_t(trace_draw_timing_resolved_) * 16);
+  trace_draw_timing_resolved_ = end;
+}
+
+void D3D12CommandProcessor::DumpTraceDrawTimings(bool gpu_complete) {
+  // ShutdownContext has already awaited GPU completion. This does not add
+  // per-draw CPU/GPU waits and cannot change guest visibility results.
+  if (gpu_complete && trace_draw_timing_readback_.mapped &&
+      trace_draw_timing_frequency_) {
+    const auto* values =
+        static_cast<const uint64_t*>(trace_draw_timing_readback_.mapped);
+    double sum_us = 0;
+    for (uint32_t i = 0; i < trace_draw_timing_resolved_; ++i) {
+      if (values[i * 2 + 1] < values[i * 2]) {
+        continue;
+      }
+      double us = double(values[i * 2 + 1] - values[i * 2]) * 1000000.0 /
+                  double(trace_draw_timing_frequency_);
+      const auto& row = trace_draw_timings_[i];
+      sum_us += us;
+      XELOGI("TraceDrawGPU index={} frame={} vs={:016X} ps={:016X} "
+             "vertices={} surface={:08X} us={:.3f}",
+             i, row.frame, row.vertex_shader, row.pixel_shader,
+             row.vertices, row.surface, us);
+    }
+    XELOGI("TraceDrawGPU total_draws={} sum_draw_us={:.3f} "
+           "(draw spans only; excludes copies/barriers/CPU waits; timing adds overhead)",
+           trace_draw_timing_resolved_, sum_us);
+  }
+  DestroyReadbackStagingBuffer(trace_draw_timing_readback_);
+  trace_draw_timing_heap_.Reset();
+  trace_draw_timings_.clear();
+  trace_draw_timing_resolved_ = 0;
+}
