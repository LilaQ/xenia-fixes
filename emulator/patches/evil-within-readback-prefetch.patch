+TextureCache::Texture* TextureCache::FindCurrentBaseOnlyVariant(TextureKey key) {
+  // Separate mip chains keep their own resources and sampler limits. Only
+  // reuse the already decoded base of an otherwise identical base-only view.
+  if (!key.mip_max_level || key.packed_mips || key.scaled_resolve ||
+      key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.GetDepthOrArraySize() != 1 || !key.base_page) {
+    return nullptr;
+  }
+  key.mip_max_level = 0;
+  key.mip_page = 0;
+  auto found = textures_.find(key);
+  if (found == textures_.end()) return nullptr;
+  auto lock = global_critical_region_.Acquire();
+  return found->second->base_outdated(lock) ? nullptr : found->second.get();
+}
