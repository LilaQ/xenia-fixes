+
+void D3D12CommandProcessor::PrefetchResolveForCpu(uint32_t address,
+                                                uint32_t length) {
+  if (!cvars::d3d12_resolve_readback_prefetch || !length || length > 65536 ||
+      shared_memory_->is_zero_copy()) {
+    return;
+  }
+  const uint64_t key = MakeReadbackResolveKey(address, length);
+  if (!ResolveReadRecently(key, false)) {
+    return;
+  }
+  const uint32_t start = address & ~uint32_t(4095);
+  const uint32_t size = ((address + length + 4095) & ~uint32_t(4095)) - start;
+  std::lock_guard<std::mutex> lock(resolve_read_mutex_);
+  auto owner_it = resolve_owners_.find(key);
+  if (owner_it == resolve_owners_.end() || owner_it->second.in_guest_ram ||
+      !owner_it->second.copyable) {
+    return;
+  }
+  auto entry_it = resolve_prefetch_.find(key);
+  if (entry_it == resolve_prefetch_.end()) {
+    if (resolve_prefetch_.size() >= 64) return;
+    entry_it = resolve_prefetch_.emplace(key, ResolvePrefetch{}).first;
+  }
+  auto& entry = entry_it->second;
+  const auto pitch = register_file_->Get<reg::RB_COPY_DEST_PITCH>();
+  const auto info = register_file_->Get<reg::RB_COPY_DEST_INFO>();
+  // Match only the four small CPU-feedback targets observed in the trace:
+  // three 32x128 floating-point planes and one 160x64 RGBA8 plane. Other
+  // targets and titles retain the synchronous path.
+  const bool feedback = cvars::evil_within_async_feedback &&
+      detail::IsEvilWithinTextureFeedback(kernel_state_->title_id(), length,
+          pitch.copy_dest_pitch, pitch.copy_dest_height,
+          uint32_t(info.copy_dest_format));
+  if (feedback && entry.buffer.resource && entry.serial) {
+    auto& history = resolve_feedback_history_[key];
+    history.push_back(std::move(entry));
+    entry = ResolvePrefetch{};
+    // Keep more staging versions than the allowed feedback age. Reusing a
+    // three-slot ring could remove the last completed snapshot when the GPU
+    // briefly fell behind, forcing a synchronous wait during camera pans.
+    if (history.size() >= 8) {
+      entry = std::move(history.front());
+      history.pop_front();
+    }
+  }
+  if (!entry.buffer.resource) {
+    if (!CreateReadbackStagingBuffer(entry.buffer, size)) return;
+    if (FAILED(GetD3D12Provider().GetDevice()->CreateFence(
+            0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&entry.fence)))) {
+      entry.buffer.resource->Unmap(0, nullptr);
+      entry.buffer.mapped = nullptr;
+      entry.buffer.resource.Reset();
+      return;
+    }
+    entry.address = start;
+    entry.length = size;
+  }
+  entry.feedback = feedback;
+  entry.frame = owner_it->second.frame;
+  entry.ready = false;
+  entry.serial = owner_it->second.serial;
+  entry.submission = GetCurrentSubmission();
+  ++entry.value;
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(
+      entry.buffer.resource.Get(), 0, shared_memory_->GetBuffer(), start, size);
+  resolve_prefetch_pending_.push_back(key);
+  // Recently CPU-read resolves already request submission in NoteResolve.
+}
+
+// Caller holds resolve_read_mutex_. Never waits or touches guest memory.
+bool D3D12CommandProcessor::CanReadUnsubmittedResolveHistory(uint64_t key) const {
+  if (!cvars::evil_within_batch_feedback ||
+      !cvars::evil_within_async_feedback ||
+      !cvars::d3d12_resolve_readback_prefetch ||
+      kernel_state_->title_id() != 0x425307F4) return false;
+  const auto owner_it = resolve_owners_.find(key);
+  const auto current_it = resolve_prefetch_.find(key);
+  if (owner_it == resolve_owners_.end() ||
+      current_it == resolve_prefetch_.end()) return false;
+  const auto& owner = owner_it->second;
+  const auto& current = current_it->second;
+  // The current shape must have passed the exact feedback guards and its
+  // fresh copy must be queued. A stale key or failed allocation cannot batch.
+  if (!current.feedback || !current.buffer.resource ||
+      current.serial != owner.serial ||
+      current.submission != owner.submission) return false;
+  const auto usable = [&](const ResolvePrefetch& candidate) {
+    if (!candidate.feedback || !candidate.ready || !candidate.fence ||
+        !detail::FeedbackAgeAllowed(owner.serial, candidate.serial,
+                                    owner.frame, candidate.frame)) return false;
+    const uint64_t completed = candidate.fence->GetCompletedValue();
+    return completed != UINT64_MAX && completed >= candidate.value;
+  };
+  if (usable(current)) return true;
+  const auto history = resolve_feedback_history_.find(key);
+  if (history != resolve_feedback_history_.end()) {
+    for (const auto& previous : history->second) {
+      if (usable(previous)) return true;
+    }
+  }
+  return false;
+}
+
+void D3D12CommandProcessor::PublishResolvePrefetchFences(
+    ID3D12CommandQueue* queue) {
+  if (resolve_prefetch_pending_.empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(resolve_read_mutex_);
+  for (uint64_t key : resolve_prefetch_pending_) {
+    auto& entry = resolve_prefetch_.at(key);
+    if (!entry.ready && SUCCEEDED(queue->Signal(entry.fence.Get(), entry.value))) {
+      entry.ready = true;
+    }
+  }
+  resolve_prefetch_pending_.clear();
+}
+
+// Called with resolve_read_mutex_ held, before a fallback copy is enqueued.
+bool D3D12CommandProcessor::TryPrefetchedResolveToGuestRam(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  if (!cvars::d3d12_resolve_readback_prefetch || ranges.empty()) {
+    return false;
+  }
+  const uint64_t key = resolve_page_owners_[ranges.front().first >> 12].load(
+      std::memory_order_relaxed);
+  auto entry_it = resolve_prefetch_.find(key);
+  auto owner_it = resolve_owners_.find(key);
+  if (entry_it == resolve_prefetch_.end() || owner_it == resolve_owners_.end()) {
+    return false;
+  }
+  auto* selected = &entry_it->second;
+  const auto& owner = owner_it->second;
+  bool completed_feedback = false;
+  if (selected->feedback && cvars::evil_within_async_feedback &&
+      kernel_state_->title_id() == 0x425307F4) {
+    ResolvePrefetch* newest = nullptr;
+    const auto consider = [&](ResolvePrefetch& candidate) {
+      if (candidate.feedback && candidate.ready &&
+          detail::FeedbackAgeAllowed(owner.serial, candidate.serial,
+                                     owner.frame, candidate.frame) &&
+          candidate.fence->GetCompletedValue() != UINT64_MAX &&
+          candidate.fence->GetCompletedValue() >= candidate.value &&
+          (!newest || candidate.serial > newest->serial)) {
+        newest = &candidate;
+      }
+    };
+    consider(*selected);
+    auto history = resolve_feedback_history_.find(key);
+    if (history != resolve_feedback_history_.end()) {
+      for (auto& previous : history->second) consider(previous);
+    }
+    if (newest) {
+      selected = newest;
+      completed_feedback = true;
+    }
+  }
+  auto& entry = *selected;
+  if (!entry.ready || (!completed_feedback &&
+      (entry.serial != owner.serial || entry.submission != owner.submission ||
+       entry.submission > GetResolveSubmittedThrough()))) {
+    return false;
+  }
+  for (const auto& range : ranges) {
+    if (range.first < entry.address ||
+        uint64_t(range.first) + range.second >
+            uint64_t(entry.address) + entry.length) {
+      return false;
+    }
+  }
+  const uint64_t start = cvars::trace_readback_timing
+      ? Clock::QueryHostTickCount() : 0;
+  // The fence was queued immediately after the resolve's command list. Unlike
+  // a fault-time queue signal, it cannot include unrelated later submissions.
+  if (!completed_feedback &&
+      FAILED(entry.fence->SetEventOnCompletion(entry.value, nullptr))) {
+    return false;
+  }
+  uint64_t bytes = 0;
+  for (const auto& range : ranges) {
+    std::memcpy(memory_->TranslatePhysical(range.first),
+                static_cast<uint8_t*>(entry.buffer.mapped) +
+                    (range.first - entry.address), range.second);
+    bytes += range.second;
+  }
+  if (start) {
+    static uint64_t count = 0, total_bytes = 0;
+    static double total_ms = 0;
+    static uint32_t slow_logs = 0;
+    const double ms = double(Clock::QueryHostTickCount() - start) * 1000.0 /
+                      double(Clock::QueryHostTickFrequency());
+    ++count;
+    total_ms += ms;
+    total_bytes += bytes;
+    if (count <= 16 || !(count % 128) ||
+        (ms > 2.0 && slow_logs++ < 256)) {
+      XELOGI("ResolvePrefetchTiming n={} address={:08X} bytes={} "
+             "ms={:.3f} total_ms={:.3f} total_bytes={} feedback={} age_frames={}",
+             count, ranges.front().first, bytes, ms, total_ms, total_bytes,
+             completed_feedback, owner.frame - entry.frame);
+    }
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::ClearResolvePrefetch() {
+  // ShutdownContext has drained the queue and removed the access callbacks.
+  for (auto& entry : resolve_prefetch_) {
+    if (entry.second.buffer.mapped) {
+      entry.second.buffer.resource->Unmap(0, nullptr);
+    }
+  }
+  for (auto& history : resolve_feedback_history_) {
+    for (auto& previous : history.second) {
+      if (previous.buffer.mapped) previous.buffer.resource->Unmap(0, nullptr);
+    }
+  }
+  resolve_feedback_history_.clear();
+  resolve_prefetch_.clear();
+  resolve_prefetch_pending_.clear();
 }
 
