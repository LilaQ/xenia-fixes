+// Game-specific safety guards for optional asynchronous texture feedback.
+#ifndef XENIA_GPU_RESOLVE_FEEDBACK_GUARDS_H_
+#define XENIA_GPU_RESOLVE_FEEDBACK_GUARDS_H_
+#include <cstdint>
+namespace xe::gpu::detail {
+constexpr bool IsEvilWithinTextureFeedback(uint32_t title, uint32_t length,
+                                          uint32_t pitch, uint32_t height,
+                                          uint32_t format) {
+  // Captured CPU-feedback targets: 32x128 RG32F / RGBA16F, and
+  // 160x64 RGBA8. All other sizes, formats and titles remain synchronous.
+  return title == 0x425307F4 &&
+      ((length == 32768 && pitch == 32 && height == 128 &&
+        (format == 37 || format == 32)) ||
+       (length == 40960 && pitch == 160 && height == 64 && format == 6));
+}
+constexpr bool FeedbackAgeAllowed(uint64_t owner_serial, uint64_t serial,
+                                  uint32_t owner_frame, uint32_t frame) {
+  return serial && serial <= owner_serial && uint32_t(owner_frame-frame) <= 4;
+}
