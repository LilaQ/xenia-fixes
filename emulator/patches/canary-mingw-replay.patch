+int TraceDump::Run() {
+  if (cvars::async_shader_compilation || !player_->frame_count()) {
+    XELOGE("Trace repetition requires a nonempty trace and synchronous shaders");
+    return 1;
+  }
+  uint32_t passes = cvars::trace_dump_repeat_count
+                        ? cvars::trace_dump_repeat_count : 1;
+  for (uint32_t pass = 0; pass < passes; ++pass) {
+    for (size_t frame = 0; frame < player_->frame_count(); ++frame) {
+      player_->ReplayFrame(int(frame));
+      player_->WaitOnPlayback();
+    }
+  }
+  int result = CaptureToPng(base_output_path_.replace_extension(".png")) ? 0 : 1;
+  XELOGI("Trace repeat complete: {} passes; final image {}", passes,
+         result ? "failed" : "written");
   player_.reset();
   emulator_.reset();
   return result;
